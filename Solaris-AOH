                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(0, height + i * 2, 0)).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.carry = function()
        while G.Carry do
            angle = angle + G.Rotationspeed
            local range = G.Rotationrange
            for i, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local a = angle + i * 10
                        local pos = (localRoot.CFrame * CFrame.new(range * math.cos(a), 8, range * math.sin(a))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.targetcarry = function()
        while G.Carry do
            angle = angle + G.Rotationspeed
            local range = G.Rotationrange
            for i, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local tr = targetPlayer and getRoot(targetPlayer.Character)
                        if tr then
                            local a = angle + i * 10
                            local pos = (tr.CFrame * CFrame.new(range * math.cos(a), 8, range * math.sin(a))).Position
                            movePlayerWithTelekinesis(pos, v.Name)
                        end
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.launchsky = function()
        while G.Carry do
            local height = G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(0, height * 20, 0)).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait(0.5)
        end
    end
    patterns.launchaway = function()
        while G.Carry do
            local range = G.Rotationrange
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local vhrp = v:FindFirstChild("HumanoidRootPart")
                        if vhrp then
                            local dir = (vhrp.Position - localRoot.Position).Unit
                            movePlayerWithTelekinesis(vhrp.Position + dir * range * 50, v.Name)
                        end
                    end)
                end
            end
            task.wait(0.3)
        end
    end
    local function makeAdvanced(speedMul, radiusFn, heightFn, angleFn)
        return function()
            while G.Carry do
                t2 = t2 + G.Rotationspeed * speedMul
                local range, height = G.Rotationrange, G.Height1
                for i, v in pairs(list) do
                    if v ~= LocalPlayer then
                        task.spawn(function()
                            local a = angleFn and angleFn(t2, i) or (t2 * 2 + i * 0.3)
                            local r = radiusFn(range, t2, i)
                            local h = heightFn(height, t2, i)
                            local pos = (localRoot.CFrame * CFrame.new(r * math.cos(a), h, r * math.sin(a))).Position
                            movePlayerWithTelekinesis(pos, v.Name)
                        end)
                    end
                end
                task.wait()
            end
        end
    end
    patterns.corkscrew = makeAdvanced(0.5, function(r)
        return r * 0.8
    end, function(h, t)
        return h + math.sin(t * 2) * h * 0.5
    end, function(t)
        return t * 3
    end)
    patterns.flower = makeAdvanced(1, function(r, t)
        return r * (1 + math.sin(t * 5) * 0.3)
    end, function(h)
        return h
    end, function(t)
        return t * 2
    end)
    patterns.wave = makeAdvanced(0.3, function(r, t, i)
        return i * 3
    end, function(h)
        return h
    end, function(t, i)
        return math.sin(t + i * 0.5) * getgenv().Rotationrange * 0.5
    end)
    patterns.sphere = makeAdvanced(0.5,
        function(r, t, i)
            local phi = #list > 0 and math.acos(2 * i / #list - 1) or 0
            return r * 1.2 * math.sin(phi)
        end,
        function(h, t, i)
            local phi = #list > 0 and math.acos(2 * i / #list - 1) or 0
            return r * 1.2 * math.cos(phi) + h
        end,
        function(t, i)
            return t + i * 0.8
        end)
    patterns.helix = makeAdvanced(0.5, function(r)
        return r * 0.8
    end, function(h, t, i)
        return h + i * 0.5
    end, function(t, i)
        return t * 2 + (i % 2 == 0 and 0 or math.pi)
    end)
    patterns.ring = function()
        while G.Carry do
            angle = angle + G.Rotationspeed * 2
            local range, height, n = G.Rotationrange, G.Height1, #list
            for i, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local a = angle + (i / (n > 0 and n or 1)) * math.pi * 2
                        local pos = (localRoot.CFrame * CFrame.new(range * math.cos(a), height, range * math.sin(a))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.bounce = makeAdvanced(1, function(r)
        return r * 0.7
    end, function(h, t, i)
        local a = t + i * 0.5
        return h + math.abs(math.sin(a)) * h * 0.8
    end, function(t, i)
        return t + i * 0.5
    end)
    patterns.galaxy = makeAdvanced(0.2, function(r, t, i)
        return r * (1 + i * 0.1) * 0.5
    end, function(h, t, i)
        return h + math.sin((t + i * 0.3) * 0.5) * 3
    end, function(t, i)
        return t + i * 0.3
    end)
    patterns.domino = makeAdvanced(0.3, function(r, t, i)
        return i * 2 - #list
    end,
    function(h, t, i)
        local offset = math.sin(t - i * 0.5) * G.Rotationrange * 0.8
        return h + offset * 0.3
    end,
    function(t, i)
        return math.sin(t - i * 0.5) * G.Rotationrange * 0.8
    end)
    patterns.pulse = makeAdvanced(0.5, function(r, t, i)
        return r * (0.5 + 0.5 * math.sin(t + i * 0.3))
    end, function(h, t, i)
        return h + math.sin(t * 2 + i) * 3
    end, function(t, i)
        return t + i * 0.8
    end)
    patterns.spiralup = makeAdvanced(0.5, function(r, t)
        return r * (1 - t * 0.05 % 0.8)
    end, function(h, t)
        return h + t * 0.5 % h
    end, function(t, i)
        return t * 2 + i * 0.3
    end)
    patterns.crystal = makeAdvanced(0.3, function(r, t, i)
        return r * (0.5 + 0.5 * math.sin(t * 3 + i * 0.5))
    end, function(h, t, i)
        return h + math.sin(t * 2 + i * 0.7) * h * 0.3
    end, function(t, i)
        return t + i * 1.2
    end)
    patterns.swirl = makeAdvanced(0.4, function(r, t, i)
        return r * (0.3 + 0.7 * math.sin(t + i * 0.1))
    end, function(h, t, i)
        return h + math.sin(t * 2 + i * 0.3) * 3
    end, function(t, i)
        return t * 1.5 + i * 0.2
    end)
    if patterns[patternType] then
        patterns[patternType]()
    end
end

local function startPattern(name, range, target)
    plrlist = {}
    getNearPlayer(range or 99999)
    G.Carry = true
    G.TelekinisisCarry = true
    local localRoot = getRoot(LocalPlayer.Character)
    if localRoot then
        executeTelekinesisPattern(name, target, localRoot, plrlist)
    end
end
local function stopPattern()
    plrlist = {}
    G.Carry = false
    G.TelekinisisCarry = false
end
local function addTeleToggle(section, title, pattern, range, useTarget, info)
    section:addToggle({ title = title, info = info or "Activates the " .. pattern .. " telekinesis pattern.", default = false,
        callback = function(state)
            if state then
                startPattern(pattern, range, useTarget and Players:FindFirstChild(G.tplayer) or nil)
            else
                stopPattern()
            end
        end })
end

