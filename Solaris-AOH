local function createESPTag(p)
    if p == LocalPlayer then
        return nil
    end
    local char = p.Character
    if not char then
        return nil
    end
    local head = char:FindFirstChild("Head")
    if not head then
        return nil
    end
    if head:FindFirstChild("ESP_Tag") then
        return head:FindFirstChild("ESP_Tag")
    end
    local tag = Instance.new("BillboardGui")
    tag.Name = "ESP_Tag"
    tag.Parent = head
    tag.Size = UDim2.new(0, 200, 0, 60)
    tag.AlwaysOnTop = true
    tag.StudsOffset = Vector3.new(0, 2.5, 0)
    tag.ZIndexBehavior = Enum.ZIndexBehavior.Global
    tag.ExtentsOffset = Vector3.new(0, 1, 0)
    local function makeLabel(name, size, pos, color, textSize)
        local l = Instance.new("TextLabel", tag)
        l.Name = name
        l.Size = size
        l.Position = pos
        l.BackgroundTransparency = 1
        l.TextColor3 = color or Color3.new(1, 1, 1)
        l.TextStrokeColor3 = Color3.new(0, 0, 0)
        l.TextStrokeTransparency = 0.3
        l.Font = Enum.Font.SourceSansBold
        l.TextSize = textSize or 14
        l.TextScaled = true
        return l
    end
    makeLabel("Name", UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 0, 0), Color3.new(1, 1, 1), 16).Text = p.Name
    local bg = Instance.new("Frame", tag)
    bg.Name = "HealthBg"
    bg.Size = UDim2.new(0.9, 0, 0, 6)
    bg.Position = UDim2.new(0.05, 0, 0, 20)
    bg.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    bg.BackgroundTransparency = 0.3
    bg.BorderSizePixel = 0
    local fill = Instance.new("Frame", bg)
    fill.Name = "HealthFill"
    fill.Size = UDim2.new(1, 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(0, 1, 0)
    fill.BorderSizePixel = 0
    makeLabel("HealthText", UDim2.new(1, 0, 0, 14), UDim2.new(0, 0, 0, 28), Color3.new(1, 1, 1), 12).Text = "100%"
    makeLabel("LevelText", UDim2.new(1, 0, 0, 14), UDim2.new(0, 0, 0, 44), Color3.new(0.5, 0.8, 1), 11).Text = "Lv: 0"
    return tag
end

local function updateESPTag(p)
    if not ESPEnabled or p == LocalPlayer then
        return
    end
    local char = p.Character
    if not char then
        return
    end
    local head = char:FindFirstChild("Head")
    if not head then
        return
    end
    local tag = head:FindFirstChild("ESP_Tag") or createESPTag(p)
    if not tag then
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local pct = hum.MaxHealth > 0 and hum.Health / hum.MaxHealth or 0
        local fill = tag:FindFirstChild("HealthBg") and tag.HealthBg:FindFirstChild("HealthFill")
        if fill then
            fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
            fill.BackgroundColor3 = pct > 0.5 and Color3.new(0, 1, 0) or pct > 0.25 and Color3.new(1, 1, 0) or Color3.new(1, 0,
                0)
        end
        local ht = tag:FindFirstChild("HealthText")
        if ht then
            ht.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
        end
    end
    local lv = 0
    if p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild("Level") then
        lv = p.leaderstats.Level.Value
    end
    local lt = tag:FindFirstChild("LevelText")
    if lt then
        lt.Text = "Lv: " .. lv
    end
end

local function loadESPPlayer(p)
    if p == LocalPlayer or not ESPEnabled then
        return
    end
    if not p.Character then
        p.CharacterAdded:Wait()
    end
    task.wait(0.5)
    ESPTags[p] = createESPTag(p)
    updateESPTag(p)
    local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Changed:Connect(function()
            if ESPEnabled then
                updateESPTag(p)
            end
        end)
    end
    if p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild("Level") then
        p.leaderstats.Level:GetPropertyChangedSignal("Value"):Connect(function()
            if ESPEnabled then
                updateESPTag(p)
            end
        end)
    end
end

local function unloadESPPlayer(p)
    if p == LocalPlayer then
        return
    end
    local char = p.Character
    if char then
        local head = char:FindFirstChild("Head")
        if head then
            local tag = head:FindFirstChild("ESP_Tag")
            if tag then
                tag:Destroy()
            end
        end
    end
    ESPTags[p] = nil
end

local function toggleESP(state)
    ESPEnabled = state
    if state then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                task.spawn(function()
                    loadESPPlayer(p)
                end)
            end
        end
        if ESPPlayerAddedConn then
            ESPPlayerAddedConn:Disconnect()
        end
        ESPPlayerAddedConn = Players.PlayerAdded:Connect(function(p)
            task.spawn(function()
                loadESPPlayer(p)
            end)
        end)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                p.CharacterAdded:Connect(function()
                    if ESPEnabled then
                        task.wait(0.5)
                        loadESPPlayer(p)
                    end
                end)
            end
        end
        task.spawn(function()
            while ESPEnabled do
                task.wait(1)
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        updateESPTag(p)
                    end
                end
            end
        end)
        Notify("ESP", "Enabled — " .. #Players:GetPlayers() .. " players", 3)
    else
        for _, p in pairs(Players:GetPlayers()) do
            unloadESPPlayer(p)
        end
        if ESPPlayerAddedConn then
            ESPPlayerAddedConn:Disconnect()
            ESPPlayerAddedConn = nil
        end
        ESPTags = {}
        Notify("ESP", "Disabled", 3)
    end
end

