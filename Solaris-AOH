local function teleportPlayersFast(pos)
    if not pos then
        return
    end
    plrlist = {}
    getNearPlayer(99999999999999)
    for _, v in pairs(plrlist) do
        local hrp = Workspace[v.Name].HumanoidRootPart
        if hrp then
            local tp = hrp:FindFirstChild("telekinesisPosition")
            if tp then
                tp:Destroy()
            end
            hrp.CFrame = pos
            task.wait(0.2)
            local ev = Events.Tele()
            if ev then
                ev:InvokeServer(Vector3.new(1, 1, 1), false, Players[v.Name].Character)
            end
        end
    end
end

