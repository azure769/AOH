local WASDTeleControl = {
    Enabled = false,
    CurrentPosition = nil,
    MovementSpeed = 5,
    HeightOffset = 0,
    Keys = { W = false, A = false, S = false, D = false, Space = false, LeftShift = false }
}

local spectateConnection

local function setupWASDTeleControl()
    local heartbeatConnection = nil
    local keyConnections = {}
    local mouse = LocalPlayer:GetMouse()
    local savedPosition = nil
    local wasdPosition = Vector3.new(2355, 81, 4)
    local lockedTarget = nil
    local function findFirstTelePlayer()
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character then
                local hrp = getRoot(v.Character)
                if hrp and hrp:FindFirstChild("telekinesisPosition") then
                    return v
                end
            end
        end
    end
    local function updateSpectate()
        if not WASDTeleControl.Enabled then
            return
        end
        if not lockedTarget then
            lockedTarget = findFirstTelePlayer()
        end
        if lockedTarget and lockedTarget.Character then
            if spectateConnection then
                spectateConnection:Disconnect()
            end
            spectateConnection = RunService.Heartbeat:Connect(function()
                if WASDTeleControl.Enabled and lockedTarget and lockedTarget.Character then
                    local head = lockedTarget.Character:FindFirstChild("Head")
                    if head then
                        workspace.CurrentCamera.CameraSubject = head
                    end
                end
            end)
        else
            if spectateConnection then
                spectateConnection:Disconnect()
                spectateConnection = nil
            end
            workspace.CurrentCamera.CameraSubject = LocalPlayer.Character
        end
    end
    local function updateWASDMovement()
        if not WASDTeleControl.Enabled then
            return
        end
        freezeLocalPlayer(true)
        updateSpectate()
        local moveVector = Vector3.new(0, 0, 0)
        local speed = WASDTeleControl.MovementSpeed
        if WASDTeleControl.Keys.W then
            moveVector = moveVector + Vector3.new(0, 0, -speed)
        end
        if WASDTeleControl.Keys.S then
            moveVector = moveVector + Vector3.new(0, 0, speed)
        end
        if WASDTeleControl.Keys.A then
            moveVector = moveVector + Vector3.new(-speed, 0, 0)
        end
        if WASDTeleControl.Keys.D then
            moveVector = moveVector + Vector3.new(speed, 0, 0)
        end
        if WASDTeleControl.Keys.Space then
            moveVector = moveVector + Vector3.new(0, speed, 0)
        end
        if WASDTeleControl.Keys.LeftShift then
            moveVector = moveVector + Vector3.new(0, -speed, 0)
        end
        if moveVector.Magnitude > 0 then
            local cam = workspace.CurrentCamera
            if cam and WASDTeleControl.CurrentPosition then
                local cf = cam.CFrame
                local hF = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z).Unit
                local hR = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z).Unit
                WASDTeleControl.CurrentPosition = WASDTeleControl.CurrentPosition + hF * -moveVector.Z + hR * moveVector.X +
                    Vector3.new(0, 1, 0) * moveVector.Y
            end
        end
        local targetPosition = WASDTeleControl.CurrentPosition
        if not targetPosition then
            local _, mousePos = Workspace:FindPartOnRayWithIgnoreList(
                Ray.new(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 1000), { LocalPlayer.Character })
            targetPosition = mousePos
        end
        if targetPosition then
            if G.TelekinisisCarry then
                local telePlayers = {}
                for _, v in pairs(Players:GetPlayers()) do
                    if v ~= LocalPlayer and v.Character then
                        local hrp = getRoot(v.Character)
                        if hrp and hrp:FindFirstChild("telekinesisPosition") then
                            table.insert(telePlayers, v)
                        end
                    end
                end
                for i, p in pairs(telePlayers) do
                    local hrp = getRoot(p.Character)
                    if hrp then
                        local angle = (i / #telePlayers) * math.pi * 2
                        movePlayerWithTelekinesis(targetPosition + Vector3.new(math.cos(angle) * 2,
                            WASDTeleControl.HeightOffset, math.sin(angle) * 2), p.Name)
                    end
                end
            elseif #plrlist > 0 then
                for i, v in pairs(plrlist) do
                    if v ~= LocalPlayer.Character then
                        local p = Players:FindFirstChild(v.Name)
                        if p and p.Character then
                            local hrp = getRoot(p.Character)
                            if hrp then
                                local angle = (i / #plrlist) * math.pi * 2
                                movePlayerWithTelekinesis(targetPosition + Vector3.new(math.cos(angle) * 2,
                                    WASDTeleControl.HeightOffset, math.sin(angle) * 2), p.Name)
                            end
                        end
                    end
                end
            end
        end
    end
    local function setupKeyListeners()
        local function onKeyInput(input, state)
            if not WASDTeleControl.Enabled then
                return
            end
            local key = input.KeyCode
            if key == Enum.KeyCode.W then
                WASDTeleControl.Keys.W = state
            elseif key == Enum.KeyCode.A then
                WASDTeleControl.Keys.A = state
            elseif key == Enum.KeyCode.S then
                WASDTeleControl.Keys.S = state
            elseif key == Enum.KeyCode.D then
                WASDTeleControl.Keys.D = state
            elseif key == Enum.KeyCode.Space then
                WASDTeleControl.Keys.Space = state
            elseif key == Enum.KeyCode.LeftShift then
                WASDTeleControl.Keys.LeftShift = state
            end
        end
        local function setupKeyConnection(inputType, state)
            local conn = UserInputService[inputType]:Connect(function(input, gameProcessed)
                if gameProcessed or not WASDTeleControl.Enabled then
                    return
                end
                onKeyInput(input, state)
            end)
            table.insert(keyConnections, conn)
        end
        setupKeyConnection("InputBegan", true)
        setupKeyConnection("InputEnded", false)
    end
    local function toggleWASDControl(state)
        WASDTeleControl.Enabled = state
        if state then
            lockedTarget = findFirstTelePlayer()
            local char = LocalPlayer.Character
            if char then
                local root = getRoot(char)
                if root then
                    savedPosition = root.Position
                    root.CFrame = CFrame.new(2355, 9999, 4)
                    task.wait(0.1)
                    root.CFrame = CFrame.new(wasdPosition)
                end
            end
            for k in pairs(WASDTeleControl.Keys) do
                WASDTeleControl.Keys[k] = false
            end
            if workspace.CurrentCamera then
                WASDTeleControl.CurrentPosition = wasdPosition
            end
            setupKeyListeners()
            if heartbeatConnection then
                heartbeatConnection:Disconnect()
            end
            heartbeatConnection = RunService.Heartbeat:Connect(updateWASDMovement)
            freezeLocalPlayer(true)
            Notify("WASD Control", lockedTarget and "Locked onto " .. lockedTarget.Name or
                "No tele players found. Will auto-lock when found.", 3)
        else
            for k in pairs(WASDTeleControl.Keys) do
                WASDTeleControl.Keys[k] = false
            end
            WASDTeleControl.CurrentPosition = nil
            lockedTarget = nil
            for _, conn in pairs(keyConnections) do
                conn:Disconnect()
            end
            keyConnections = {}
            if heartbeatConnection then
                heartbeatConnection:Disconnect()
                heartbeatConnection = nil
            end
            if spectateConnection then
                spectateConnection:Disconnect()
                spectateConnection = nil
            end
            local char = LocalPlayer.Character
            if char then
                local root = getRoot(char)
                if root and savedPosition then
                    root.CFrame = CFrame.new(savedPosition)
                end
            end
            workspace.CurrentCamera.CameraSubject = LocalPlayer.Character
            freezeLocalPlayer(false)
        end
    end
    return toggleWASDControl
end

