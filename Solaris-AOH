            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(math.random(-range * 0.5, range * 0.5), 8 + math.random(
                            -range * 0.2, range * 0.2), math.random(-range * 0.5, range * 0.5))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
