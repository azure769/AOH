local MouseTeleControl = { Enabled = false, TargetPosition = nil, MovementSpeed = 0.1, HeightOffset = 0 }

local function setupMouseTeleControl()
    local mouse = LocalPlayer:GetMouse()
    local indicator = Instance.new("Part")
    indicator.Name = "MouseTeleIndicator"
    indicator.Size = Vector3.new(1, 0.5, 1)
    indicator.BrickColor = BrickColor.new("Bright red")
    indicator.Material = Enum.Material.Neon
    indicator.Anchored = true
    indicator.CanCollide = false
    indicator.Transparency = 0.5
    indicator.Parent = Workspace
    local circle = Instance.new("Part")
    circle.Name = "MouseTeleCircle"
    circle.Size = Vector3.new(0.1, 0.1, 0.1)
    circle.BrickColor = BrickColor.new("Bright green")
    circle.Material = Enum.Material.Neon
    circle.Anchored = true
    circle.CanCollide = false
    circle.Transparency = 0.3
    circle.Parent = Workspace
    local mouseMoveConnection = nil
    local function updateMousePosition()
        if not G.MouseTeleControl then
            return
        end
        local _, position = Workspace:FindPartOnRayWithIgnoreList(
            Ray.new(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 1000), { LocalPlayer.Character, indicator, circle })
        if position then
            MouseTeleControl.TargetPosition = position
            indicator.CFrame = CFrame.new(position)
            circle.Position = position
            freezeLocalPlayer(true)
            if G.TelekinisisCarry then
                local telePlayers = {}
                for _, v in pairs(Players:GetPlayers()) do
                    if v ~= LocalPlayer and v.Character then
                        local hrp = getRoot(v.Character)
                        if hrp and hrp:FindFirstChild("telekinesisPosition") then
                            table.insert(telePlayers, v)
                        end
                    end
                end
                for i, p in pairs(telePlayers) do
                    local hrp = getRoot(p.Character)
                    if hrp then
                        local angle = (i / #telePlayers) * math.pi * 2
                        local targetPos = position + Vector3.new(math.cos(angle) * 2, MouseTeleControl.HeightOffset,
                            math.sin(angle) * 2)
                        movePlayerWithTelekinesis(hrp.Position:Lerp(targetPos, MouseTeleControl.MovementSpeed), p.Name)
                    end
                end
            elseif #plrlist > 0 then
                for i, v in pairs(plrlist) do
                    if v ~= LocalPlayer.Character then
                        local p = Players:FindFirstChild(v.Name)
                        if p and p.Character then
                            local hrp = getRoot(p.Character)
                            if hrp then
                                local angle = (i / #plrlist) * math.pi * 2
                                local targetPos = position + Vector3.new(math.cos(angle) * 2, MouseTeleControl.HeightOffset,
                                    math.sin(angle) * 2)
                                movePlayerWithTelekinesis(hrp.Position:Lerp(targetPos, MouseTeleControl.MovementSpeed), p.Name)
                            end
                        end
                    end
                end
            end
        end
    end
    local function enableMouseTracking()
        if mouseMoveConnection then
            mouseMoveConnection:Disconnect()
        end
        mouseMoveConnection = UserInputService.InputChanged:Connect(function(input, gameProcessed)
            if gameProcessed or not G.MouseTeleControl then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                updateMousePosition()
            end
        end)
    end
    local function toggleMouseControl(state)
        G.MouseTeleControl = state
        if state then
            updateMousePosition()
            enableMouseTracking()
            indicator.Transparency = 0.3
            circle.Transparency = 0.2
            freezeLocalPlayer(true)
            Notify("Mouse Control", "Move mouse to control telekinesis" .. (G.TelekinisisCarry and " (Carry mode)" or ""), 2)
        else
            indicator.Transparency = 1
            circle.Transparency = 1
            if mouseMoveConnection then
                mouseMoveConnection:Disconnect()
                mouseMoveConnection = nil
            end
            freezeLocalPlayer(false)
        end
    end
    return toggleMouseControl, indicator, circle
end

