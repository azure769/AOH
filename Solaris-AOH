local farmMode = "Normal"
local selectedFarmNPC = "Civilian"
local isFarming = false
local laserCoroutines = {}
local initialPositions = { Civilian = nil, Police = nil, Thug = nil }

local function stopFarm()
    isFarming = false
    if farmMode == "Laser" then
        for _, co in pairs(laserCoroutines) do
            if coroutine.status(co) ~= "dead" then
                pcall(coroutine.close, co)
            end
        end
        laserCoroutines = {}
        local ev = Events.Laser()
        if ev then
            ev:InvokeServer(false)
        end
    else
        G[selectedFarmNPC] = false
        task.wait(0.2)
        local root = LocalPlayer.Character and getRoot(LocalPlayer.Character)
        if root and initialPositions[selectedFarmNPC] then
            root.CFrame = CFrame.new(initialPositions[selectedFarmNPC])
        end
    end
end

local function startFarm()
    if not LocalPlayer.Character then
        return
    end
    if farmMode == "Laser" then
        isFarming = true
        local co = coroutine.create(function()
            local ev = Events.Laser()
            if not ev then
                return
            end
            local part = ev:InvokeServer(true)
            while isFarming and part do
                task.wait()
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Model") and v.Name == selectedFarmNPC then
                        local hum = v:FindFirstChildOfClass("Humanoid")
                        local root = getRoot(v)
                        if hum and hum.Health > 0 and root then
                            part.Position = root.Position
                        end
                    end
                end
            end
            ev:InvokeServer(false)
        end)
        table.insert(laserCoroutines, co)
        coroutine.resume(co)
    else
        local root = getRoot(LocalPlayer.Character)
        if root then
            initialPositions[selectedFarmNPC] = root.Position
        end
        G[selectedFarmNPC] = true
        isFarming = true
        task.spawn(function()
            local lastPunch = 0
            while isFarming and G[selectedFarmNPC] do
                task.wait(0.2)
                pcall(function()
                    local now = tick()
                    if now - lastPunch < 0.5 then
                        return
                    end
                    lastPunch = now
                    local lr = getRoot(LocalPlayer.Character)
                    if not lr then
                        return
                    end
                    local best, bestDist = nil, math.huge
                    for _, v in pairs(Workspace:GetChildren()) do
                        if v:IsA("Model") and v.Name == selectedFarmNPC then
                            local hum = v:FindFirstChildOfClass("Humanoid")
                            local vroot = getRoot(v)
                            if hum and hum.Health > 0 and vroot then
                                local d = (vroot.Position - lr.Position).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    best = v
                                end
                            end
                        end
                    end
                    if best then
                        local vroot = getRoot(best)
                        if vroot then
                            lr.CFrame = vroot.CFrame * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            local ev = Events.Punch()
                            if ev then
                                ev:FireServer(0, 0.1, 1)
                            end
                        end
                    end
                end)
            end
        end)
    end
end

