local function executeTelekinesisPattern(patternType, targetPlayer, localRoot, list)
    if not localRoot then
        return
    end
    local angle, t2 = 0, 0
    local patterns = {}
    patterns.spiral = function()
        while G.Carry do
            t2 = t2 + G.Rotationspeed
            local range, height = G.Rotationrange, G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local a = t2 * 2
                        local pos = (localRoot.CFrame * CFrame.new((range + math.sin(t2) * 5) * math.cos(a), height + math.sin(
                            t2 * 1.5) * 3, (range + math.sin(t2) * 5) * math.sin(a))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.figure8 = function()
        while G.Carry do
            t2 = t2 + G.Rotationspeed * 0.5
            local range, height = G.Rotationrange, G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(range * 1.5 * math.sin(t2), height, range * math.sin(
                            2 * t2))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.chaos = function()
        while G.Carry do
            local range, height = G.Rotationrange, G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local ra = math.random() * math.pi * 2
                        local rv = math.random() * math.pi * 2
                        local rd = math.random() * range
                        local pos = (localRoot.CFrame * CFrame.new(range * math.cos(ra), rd * math.sin(rv) + height, range *
                            math.sin(ra))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.hyperspin = function()
        while G.Carry do
            angle = angle + G.Rotationspeed * 5
            local range, height = G.Rotationrange, G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(range * 2 * math.cos(angle * 3), height * 0.2 + 5 *
                            math.sin(angle * 2), range * 2 * math.sin(angle * 3))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.orbit = function()
        while G.Carry do
            angle = angle + G.Rotationspeed
            local range, height = G.Rotationrange, G.Height1
            for _, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local pos = (localRoot.CFrame * CFrame.new(range * 1.5 * math.cos(angle), height + 3 * math.sin(angle),
                            range * 1.5 * math.sin(angle))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.doubleorbit = function()
        local a1, a2 = 0, 0
        while G.Carry do
            a1 = a1 + G.Rotationspeed
            a2 = a2 + G.Rotationspeed * 1.5
            local range, height = G.Rotationrange, G.Height1
            for i, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local tr = targetPlayer and getRoot(targetPlayer.Character)
                        if tr then
                            local r2 = range * 1.5 + (i % 2 == 0 and 5 or -5)
                            local a = i % 2 == 0 and a1 or a2
                            local pos = (tr.CFrame * CFrame.new(r2 * math.cos(a), height + 3 * math.sin(a), r2 * math.sin(
                                a))).Position
                            movePlayerWithTelekinesis(pos, v.Name)
                        end
                    end)
                end
            end
            task.wait()
        end
    end
    patterns.tornado = function()
        while G.Carry do
            angle = angle + G.Rotationspeed * 2
            local range, height = G.Rotationrange, G.Height1
            for i, v in pairs(list) do
                if v ~= LocalPlayer then
                    task.spawn(function()
                        local r2 = range * 0.5 + i * 3
                        local h = height * 0.1 + i * 2
                        local pos = (localRoot.CFrame * CFrame.new(r2 * math.cos(angle + i * 0.5), h * math.sin(angle *
                            0.5) + height * 0.3, r2 * math.sin(angle + i * 0.5))).Position
                        movePlayerWithTelekinesis(pos, v.Name)
                    end)
                end
            end
            task.wait()
        end
