local function getHumanoid(player)
    local c = player and player.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot(char)
    if not char then
        return nil
    end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function getPlayerByName(name)
    if not name or name == "" then
        return nil
    end
    local low = string.lower(name)
    for _, p in pairs(Players:GetPlayers()) do
        if string.lower(p.Name) == low or string.lower(p.DisplayName) == low then
            return p
        end
    end
    return nil
end

local function Notify(title, text, dur)
    Window:Notify({title = title, text = text, duration = dur or 5})
end

local function setTarget(va)
    if not va or va == "" then
        return
    end
    local lower = string.lower(va)
    for _, p in pairs(Players:GetPlayers()) do
        if string.find(string.lower(p.DisplayName), lower, 1, true) or string.find(string.lower(p.Name), lower, 1, true) then
            G.tplayer = p.Name
            Notify("Player Selected", p.Name .. " selected as Target.")
            return
        end
    end
    Notify("Error", "Player not found!", 3)
end

local function addHplayer(va)
    if not va or va == "" then
        return
    end
    local lower = string.lower(va)
    for _, p in pairs(Players:GetPlayers()) do
        if string.find(string.lower(p.DisplayName), lower, 1, true) or string.find(string.lower(p.Name), lower, 1, true) then
            if not G.selectedPlayers[p.Name] then
                G.selectedPlayers[p.Name] = p
                Notify("Player Added", p.Name .. " added to Hplayers.")
            end
            return
        end
    end
end

local function getFriendsInGame()
    local out = {}
    for _, p in pairs(Players:GetPlayers()) do
        local ok, result = pcall(function()
            local pages = LocalPlayer:GetFriendsAsync()
            for _, f in ipairs(pages:GetCurrentPage()) do
                if f.Username == p.Name then
                    return true
                end
            end
            return false
        end)
        if ok and result then
            table.insert(out, p)
        end
    end
    return out
end

local function sendWebhook(level, playerName)
    if not G.WebhookEnabled or G.WebhookURL == "" then
        return
    end
    if level == G.LastLevelSent then
        return
    end
    G.LastLevelSent = level

    local data = {
        content = "",
        embeds = {{
            title = "Level Update",
            description = string.format("**%s** has reached level **%d**!", playerName or LocalPlayer.DisplayName, level),
            color = 3066993,
            footer = { text = "Solaris Webhook" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    local success, err = pcall(function()
        local req = syn and syn.request or http_request or request
        if req then
            local response = req({
                Url = G.WebhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(data)
            })
            return response
        end
    end)

    if not success then
        warn("Webhook failed:", err)
    end
end

