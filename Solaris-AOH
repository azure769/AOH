local function StartLevelRepFarm()
    if RepFarm.IsRunning then
        Notify("Level Farm", "Already running!", 2)
        return
    end
    if RepFarm.TargetPlayer == "" then
        Notify("Level Farm", "Please enter a target player name!", 3)
        return
    end
    local target = getPlayerByName(RepFarm.TargetPlayer)
    if not target then
        Notify("Level Farm", "Target player not found!", 3)
        return
    end
    RepFarm.IsRunning = true
    RepFarm.CurrentPhase = 1
    UpdateRepFarmStatus("Phase 1 - Farming")
    Notify("Level Farm", "Started! Target: " .. target.Name, 3)
    local mev = Events.Metal()
    if mev then
        mev:FireServer("metalSkin", true)
    end
    RepFarm.FarmCoroutine = task.spawn(function()
        while RepFarm.IsRunning do
            local ct = getPlayerByName(RepFarm.TargetPlayer)
            if not ct or not ct.Character then
                UpdateRepFarmStatus("Target lost!")
                Notify("Level Farm", "Target lost! Stopping...", 3)
                RepFarm.IsRunning = false
                break
            end
            local rep = 0
            if ct:FindFirstChild("leaderstats") and ct.leaderstats:FindFirstChild("Level") then
                rep = ct.leaderstats.Level.Value
            end
            local lr = getRoot(LocalPlayer.Character)
            local tr = getRoot(ct.Character)
            if lr and tr then
                lr.CFrame = tr.CFrame * CFrame.new(0, 0, 2)
                if RepFarm.CurrentPhase == 1 then
                    if rep >= RepFarm.MaxRep then
                        RepFarm.CurrentPhase = 2
                        UpdateRepFarmStatus("Phase 2 - Waiting for rep drop")
                        Notify("Level Farm", "Target reached " .. RepFarm.MaxRep .. " rep! Switching to Phase 2", 2)
                    else
                        local ev = Events.Punch()
                        if ev then
                            for _ = 1, 3 do
                                ev:FireServer(0.4, 0.1, 1)
                                task.wait(0.05)
                            end
                        end
                        UpdateRepFarmStatus("Phase 1 - Farming (Rep: " .. rep .. "/" .. RepFarm.MaxRep .. ")")
                    end
                elseif RepFarm.CurrentPhase == 2 then
                    if rep <= RepFarm.MinRep then
                        RepFarm.CurrentPhase = 1
                        UpdateRepFarmStatus("Phase 1 - Farming resumed")
                        Notify("Level Farm", "Target dropped to " .. RepFarm.MinRep .. " rep! Switching to Phase 1", 2)
                    else
                        UpdateRepFarmStatus("Phase 2 - Waiting (Rep: " .. rep .. "/" .. RepFarm.MinRep .. ")")
                        task.wait(1)
                    end
                end
            else
                UpdateRepFarmStatus("Waiting for character...")
                task.wait(0.5)
            end
            RepFarm.LastCheckedRep = rep
            task.wait(0.2)
        end
        if not RepFarm.IsRunning then
            UpdateRepFarmStatus("Stopped")
            Notify("Level Farm", "Stopped!", 2)
            local mev2 = Events.Metal()
            if mev2 then
                mev2:FireServer("metalSkin", false)
            end
        end
    end)
end

local function StopLevelRepFarm()
    if RepFarm.IsRunning then
        RepFarm.IsRunning = false
        UpdateRepFarmStatus("Stopping...")
        Notify("Level Farm", "Stopping...", 2)
        if RepFarm.FarmCoroutine then
            task.wait(0.5)
            RepFarm.FarmCoroutine = nil
        end
    else
        Notify("Level Farm", "Not currently running!", 2)
    end
end

