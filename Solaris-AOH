local function cleanupControls()
    if indicator then
        indicator:Destroy()
    end
    if circle then
        circle:Destroy()
    end
    if G.MouseTeleControl then
        toggleMouseControl(false)
    end
    if WASDTeleControl.Enabled then
        toggleWASDControl(false)
    end
    if spectateConnection then
        spectateConnection:Disconnect()
        spectateConnection = nil
    end
    freezeLocalPlayer(false)
    workspace.CurrentCamera.CameraSubject = LocalPlayer.Character
end

local originalClose = Window.close
Window.close = function(...)
    cleanupControls()
    return originalClose(...)
end

